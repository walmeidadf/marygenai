aws_profile        = null
aws_region         = "us-east-2"
environment        = "dev"
custom_domain_name = "mcp-server.marygenai.com"

index_file_path    = "../../data/normalized/retrieval_indexes/marygenai_candidate_retrieval_3437.duckdb"
manifest_file_path = "../../data/normalized/retrieval_indexes/marygenai_candidate_retrieval_3437.manifest.json"
lambda_zip_path    = "../../build/lambda/marygenai-mcp.zip"

# Generate locally with: uv run marygenai mcp generate-access-token
# Store the plaintext token in a password manager. Terraform receives only its digest.
mcp_bearer_token_sha256    = "replace-with-64-lowercase-hexadecimal-digits"
viewer_bearer_token_sha256 = "replace-with-a-different-64-lowercase-hexadecimal-digest"
allow_query_token          = true
